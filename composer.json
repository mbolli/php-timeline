{
    "name": "timeline/app",
    "description": "Life Timeline Application - PHP/Mezzio/Swoole/SQLite",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-swoole": "*",
        "laminas/laminas-config-aggregator": "^1.15",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-servicemanager": "^4.0",
        "mezzio/mezzio": "^3.19",
        "mezzio/mezzio-fastroute": "^3.11",
        "mezzio/mezzio-helpers": "^5.16",
        "mezzio/mezzio-swoole": "^4.9",
        "starfederation/datastar-php": "^1.0.0-RC.5"
    },
    "require-dev": {
        "ext-inotify": "*",
        "friendsofphp/php-cs-fixer": "^3.67",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^v1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/type-perfect": "^v2.0",
        "roave/security-advisories": "dev-latest",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "serve": "php swoole-server.php",
        "serve:mezzio": "./vendor/bin/laminas mezzio:swoole:start",
        "db:seed": "php bin/seed.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "RC",
    "prefer-stable": true
}
