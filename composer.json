{
    "name": "timeline/app",
    "description": "Life Timeline Application - PHP/Mezzio/Swoole/SQLite",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-swoole": "*",
        "laminas/laminas-cli": "^1.16",
        "laminas/laminas-config-aggregator": "^1.21",
        "laminas/laminas-diactoros": "^3.10",
        "laminas/laminas-servicemanager": "^4.6",
        "mezzio/mezzio": "^3.29",
        "mezzio/mezzio-fastroute": "^3.15",
        "mezzio/mezzio-helpers": "^5.21",
        "mezzio/mezzio-swoole": "^4.14",
        "starfederation/datastar-php": "^1.0.3"
    },
    "require-dev": {
        "ext-inotify": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roave/security-advisories": "dev-latest",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/laminas mezzio:swoole:start"
        ],
        "stop": "./vendor/bin/laminas mezzio:swoole:stop",
        "db:seed": "php bin/seed.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "prefer-stable": true
}
